# File: .env cho {{ app_name }} trên {{ env_name }}
# Chứa các biến môi trường runtime

NODE_ENV={{ env_name | default('production') }}
PORT={{ app_port }}
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://{{ pg_user }}:{{ pg_password | default('CHANGEME') }}@{% if groups['dbservers'] is defined and groups['dbservers']|length > 0 %}{{ hostvars[groups['dbservers'][0]]['ansible_host'] }}{% else %}127.0.0.1{% endif %}:{{ pg_port }}/{{ pg_db }}
DB_POOL_MAX=20

# JWT
JWT_SECRET={{ jwt_secret | default('CHANGEME_GENERATE_RANDOM_64_CHARS') }}
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info
LOG_DIR={{ app_logs_dir }}

# CORS
CORS_ORIGIN={{ cors_origin | default('*') }}

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
