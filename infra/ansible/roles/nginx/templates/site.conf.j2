# Nginx site config cho {{ app_name }}
# Reverse proxy + rate limit + health check

# Upstream backend
upstream {{ app_name }}_backend {
    least_conn;
    server 127.0.0.1:{{ app_port }} max_fails=3 fail_timeout=30s;
    keepalive 32;
}

# HTTP server
server {
    listen 80;
    listen [::]:80;
    server_name {{ nginx_server_name }} _;

    # Logging JSON
    access_log /var/log/nginx/{{ app_name }}.access.log json_combined;
    error_log  /var/log/nginx/{{ app_name }}.error.log;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    {% if force_https %}
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    {% endif %}

    # Rate limit + connection limit
    limit_req zone={{ app_name }}_req burst=20 nodelay;
    limit_conn {{ app_name }}_conn 50;

    # Health check endpoint (không qua proxy, trả về nhanh)
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Block hidden files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Gzip
    gzip on;
    gzip_proxied any;
    gzip_types text/plain text/css application/json application/javascript;

    # Client body size
    client_max_body_size {{ nginx_client_max_size }};

    # Static files (nếu có)
    location {{ static_alias }}/ {
        alias {{ static_root }}/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # API proxy
    location / {
        proxy_pass http://{{ app_name }}_backend;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Timeouts
        proxy_connect_timeout {{ nginx_proxy_timeout }};
        proxy_send_timeout    {{ nginx_proxy_timeout }};
        proxy_read_timeout    {{ nginx_proxy_timeout }};

        # Buffers
        proxy_buffering on;
        proxy_buffer_size 16k;
        proxy_buffers 8 16k;

        # Không cache API responses
        proxy_no_cache 1;
        proxy_cache_bypass 1;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}

{% if nginx_ssl_enabled %}
# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ nginx_server_name }};

    ssl_certificate     {{ nginx_ssl_cert_path }};
    ssl_certificate_key {{ nginx_ssl_key_path }};

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # ... cùng config như HTTP server ở trên
    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }
    location / {
        proxy_pass http://{{ app_name }}_backend;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# Redirect HTTP -> HTTPS
server {
    listen 80;
    server_name {{ nginx_server_name }};
    return 301 https://$host$request_uri;
}
{% endif %}
