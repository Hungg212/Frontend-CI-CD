# Production build settings (Vite loads this AFTER .env, so it wins).
#
# Empty API base => the app calls "/api" on its own origin, and CloudFront
# reverse-proxies /api/* to the EC2 backend. No CORS, no mixed content.
# Set this to an absolute URL only if the API lives on a different hostname.
VITE_APP_ENV=production
VITE_API_BASE_URL=
